[Unit]
Description=PopDex 10-minute snapshot (insurance funds, vault, OI/funding, bridge, chain sample)
After=network-online.target

[Service]
Type=oneshot
User=__USER__
WorkingDirectory=/opt/popdex/code
Environment=DATA_DIR=/opt/popdex/data-snapshot
Environment=PUBLISH=1
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/popdex/venv/bin/python collector/snapshot.py
TimeoutStartSec=15min
Nice=10
