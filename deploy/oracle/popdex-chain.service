[Unit]
Description=PopDex on-chain sample (600 blocks: active accounts, UI vs bot, cancel ratio)
After=network-online.target

[Service]
Type=oneshot
User=__USER__
WorkingDirectory=/opt/popdex/code
Environment=DATA_DIR=/opt/popdex/data-snapshot
Environment=PUBLISH=1
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/popdex/venv/bin/python collector/snapshot.py active_accounts
TimeoutStartSec=15min
Nice=10
