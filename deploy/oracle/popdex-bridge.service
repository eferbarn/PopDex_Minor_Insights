[Unit]
Description=PopDex bridge scan (USDT deposits/withdrawals on Arbitrum + Morph)
After=network-online.target

[Service]
Type=oneshot
User=__USER__
WorkingDirectory=/opt/popdex/code
Environment=DATA_DIR=/opt/popdex/data-snapshot
Environment=PUBLISH=1
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/popdex/venv/bin/python collector/snapshot.py bridge
TimeoutStartSec=20min
Nice=10
